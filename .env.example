# Environment Configuration

## Backend
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
MONGODB_URL=mongodb://localhost:27017

## Frontend
# Leave NEXT_PUBLIC_API_BASE_URL empty to use the Next.js proxy in next.config.ts.
# Set it to http://localhost:8000 only if you want the browser to call FastAPI directly.
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
